import java_cup.runtime.*;

parser code {:
    boolean deveExecutarBloco = false;
    double somatorio = 0.0;
    int totalExpressoes = 0;
:}

/* TERMINAIS */
terminal PTVIRG, PTO, MAIS, MENOS, DIV, MULT, MOD;
terminal ABRE_PARENT, FECHA_PARENT, ABRE_CHAVE, FECHA_CHAVE, ABRE_COLCH, FECHA_COLCH;
terminal KW_IF, KW_ELSE;
terminal String OP_RELACIONAL;
terminal Double NUMBER, IDENT;

/* NÃO TERMINAIS */
non terminal if, else, condicao;
non terminal expr_list, expr_ptv;
non terminal Double expr, term, factor, designator;

if ::=
        {: System.out.print("if("); :}
        KW_IF ABRE_PARENT condicao FECHA_PARENT
        ABRE_CHAVE {: System.out.println("){"); :}
        expr_list
        FECHA_CHAVE
        {:
            /* Imprime resumo do bloco IF só se ele foi executado */
            if (parser.deveExecutarBloco) {
                System.out.println("somatorio = " + parser.somatorio);
                System.out.println("totalExpressoes= " + parser.totalExpressoes);
            }
            System.out.println("}");
            /* Zera acumuladores antes de entrar no else */
            parser.somatorio = 0.0;
            parser.totalExpressoes = 0;
        :}
        else
        ;

else ::=
        {:
            /*
             * Invertemos deveExecutarBloco:
             *   - se o IF foi true  -> else agora é false (não executa)
             *   - se o IF foi false -> else agora é true  (executa)
             */
            parser.deveExecutarBloco = !parser.deveExecutarBloco;
            System.out.print("else{");
        :}
        KW_ELSE ABRE_CHAVE
        expr_list
        FECHA_CHAVE
        {:
            if (parser.deveExecutarBloco) {
                System.out.println("somatorio = " + parser.somatorio);
                System.out.println("totalExpressoes= " + parser.totalExpressoes);
            }
            System.out.println("}");
        :}
    |
        /* vazio — imprime else vazio de qualquer forma para manter formato da saída */
        {: System.out.println("else{"); System.out.println("}"); :}
    ;

condicao ::= expr:e1 OP_RELACIONAL:op expr:e2
        {:
            boolean resultado = false;
            switch (op) {
                case "<":  resultado = (e1 < e2);  break;
                case "<=": resultado = (e1 <= e2); break;
                case ">":  resultado = (e1 > e2);  break;
                case ">=": resultado = (e1 >= e2); break;
                case "==": resultado = (e1 == e2); break;
                case "!=": resultado = (e1 != e2); break;
                default:   System.out.println("*Simbolo desconhecido");
            }
            parser.deveExecutarBloco = resultado;
            System.out.print(resultado);
        :};

expr_list ::=
            expr_list expr_ptv
        |   expr_ptv
        ;

expr_ptv ::=
        expr:e
        {:
            if (parser.deveExecutarBloco) {
                parser.somatorio      += e;
                parser.totalExpressoes += 1;
            }
        :}
        PTVIRG
        ;

expr ::=
            expr:e MAIS term:t   {: RESULT = e + t; :}
        |   expr:e MENOS term:t  {: RESULT = e - t; :}
        |   MENOS term:t         {: RESULT = -t;    :}
        |   term:t               {: RESULT = t.doubleValue(); :}
        ;

term ::=
            factor:f MULT term:t  {: RESULT = f * t;            :}
        |   factor:f DIV  term:t  {: RESULT = f / t;            :}
        |   factor:f              {: RESULT = f.doubleValue();   :}
        ;

factor ::=
            NUMBER:n                        {: RESULT = n.doubleValue(); :}
        |   ABRE_PARENT expr:e FECHA_PARENT {: RESULT = e.doubleValue(); :}
        |   designator:d                    {: RESULT = d.doubleValue(); :}
        ;

designator ::=
            designator ABRE_COLCH expr FECHA_COLCH  {: RESULT = Double.valueOf(1.0); :}
        |   designator PTO IDENT                    {: RESULT = Double.valueOf(1.0); :}
        |   IDENT                                   {: RESULT = Double.valueOf(1.0); :}
        ;
